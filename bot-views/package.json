{
  "name": "habitat-control",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A 3D colony sim where every coding-agent thread on your machine is a little astronaut building something. A fork of Bot Crossing (https://botcrossing.com) by Jarren Rocks.",
  "license": "MIT",
  "author": "Jarren Rocks",
  "homepage": "https://github.com/panamania/Habitat-Control",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/panamania/Habitat-Control.git"
  },
  "bugs": {
    "url": "https://github.com/panamania/Habitat-Control/issues"
  },
  "keywords": [
    "claude-code",
    "coding-agent",
    "three.js",
    "webgl",
    "colony-sim",
    "developer-tools",
    "visualization"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "os": [
    "darwin",
    "win32",
    "linux"
  ],
  "scripts": {
    "dev": "npm run assets --silent && vite",
    "build": "npm run assets --silent && vite build",
    "start": "vite build && node server/serve.mjs",
    "serve": "node server/serve.mjs",
    "assets": "node tools/build-assets.mjs",
    "test": "node --test \"test/**/*.test.mjs\""
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-agent": "^3.700.0",
    "@aws-sdk/client-bedrock-agent-runtime": "^3.700.0",
    "@kubernetes/client-node": "^2.0.0",
    "@mdi/js": "^7.4.47",
    "three": "^0.185.0"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.4.2",
    "@gltf-transform/functions": "^4.4.2",
    "vite": "^7.1.0"
  }
}
